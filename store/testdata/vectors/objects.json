  "chunk_stream_refused": [
    {
      "name": "ends-mid-header",
      "stream_hex": "111111111111111111111111111111111111111111111111111111111111111101000000",
      "why": "one byte short of a header. The header is fixed-width so a reader can take it without a loop, which is also why a short one is unambiguous"
    },
    {
      "name": "ends-mid-payload",
      "stream_hex": "30ec2f855071fb404f5ced96a5b0743d61a6adeeaacd7c6445240c5d52e18b5700000003e873696c6f",
      "why": "declares 1000 bytes and carries four. A decoder that trusts the length hands its caller a truncated chunk, or reads past its buffer"
    },
    {
      "name": "length-over-the-limit",
      "stream_hex": "22222222222222222222222222222222222222222222222222222222222222220008000000",
      "why": "128 MiB, over the 64 MiB frame bound. The bound exists so an allocation is sized from the format and not from the number a stranger sent"
    },
    {
      "name": "absent-with-a-length",
      "stream_hex": "33333333333333333333333333333333333333333333333333333333333333330100000005",
      "why": "absence is a status byte, not a length of zero, and the two must not disagree — a reader inferring absence from the length reads this as present"
    },
    {
      "name": "unknown-status",
      "stream_hex": "44444444444444444444444444444444444444444444444444444444444444440300000000",
      "why": "a status this version does not define — 0, 1 and 2 are present, absent and the terminator. A later version may define more, and a decoder that treats anything non-zero as absent would silently lose those bytes"
    },
    {
      "name": "ends-without-a-terminator",
      "stream_hex": "55555555555555555555555555555555555555555555555555555555555555550100000000",
      "why": "one complete, well-formed frame and then the body stops. This is the shape a server cut off mid-response produces, and it is the reason the terminator exists: nothing in a run of whole frames says whether the count was the intended one, so a decoder that stops at the end of the buffer reports a short answer as a complete one"
    },
    {
      "name": "id-does-not-match-the-bytes",
      "stream_hex": "30ec2f855071fb404f5ced96a5b0743d61a6adeeaacd7c6445240c5d52e18b56000000000473696c6f",
      "why": "the valid frame for the four bytes \"silo\" with one bit flipped in its id. Verifying on arrival is what makes a chunk from a cache of uncertain provenance, a peer, or a mirror legal to use at all"
    }
  ]
