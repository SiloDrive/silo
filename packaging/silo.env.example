# /etc/silo/silo.env -- read by systemd as root, before it drops to the silo
# user, so this file is the right place for secrets. Installed mode 0600.
#
# These override /etc/silo/silo.conf. The full table is in the README.
# Nothing here is required: Silo starts with no variables set at all.

# --- Behind a reverse proxy -------------------------------------------------
# Set this whenever anything proxies to Silo, or every client on the server
# shares one rate-limit bucket and a single attacker locks out the install.
# Do NOT set it if Silo is reachable directly -- the header is then written by
# whoever is talking to it. See docs/deployment.md.
#SILO_TRUST_PROXY_HEADERS=true

# How many proxies stand in front. 1 covers Caddy or nginx and nothing else;
# 2 is Cloudflare in front of Caddy. Too high hands clients a rate-limit key
# they choose, so it never grows on its own.
#SILO_TRUSTED_PROXY_HOPS=1

# --- Placement --------------------------------------------------------------
# The unit sets this to /var/lib/silo before reading this file, so uncommenting
# it here wins. ProtectSystem=strict will block any other path until you add it
# with `systemctl edit silo`:  [Service] / ReadWritePaths=/your/path
#SILO_DATA_DIR=/var/lib/silo

# --- Error reporting --------------------------------------------------------
# Sentry, Splat or GlitchTip. This is a credential; it is why the file is 0600.
#SILO_SENTRY_DSN=
#SILO_SENTRY_ENVIRONMENT=production
#SILO_SENTRY_TRACES_SAMPLE_RATE=0.1
#SILO_SENTRY_SERVER_NAME=

# --- Policy -----------------------------------------------------------------
#SILO_ALLOW_USER_CREATE_LIBRARY=true
#SILO_LOG_LEVEL=info
